<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <!-- Indicateur couleur du type de sol -->
        <View
            android:id="@+id/indicateur"
            android:layout_width="5dp"
            android:layout_height="56dp"
            android:layout_marginEnd="14dp"
            android:background="#1D9E75"/>

        <!-- Infos principales -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Classe + emoji -->
            <TextView
                android:id="@+id/tvClasse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚫ Black Soil"
                android:textColor="#2C2C2A"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <!-- Nom français -->
            <TextView
                android:id="@+id/tvNomFr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Sol Noir (Vertisol)"
                android:textColor="#5F5E5A"
                android:textSize="12sp"/>

            <!-- Date -->
            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="17/05/2026 14:30"
                android:textColor="#B4B2A9"
                android:textSize="11sp"/>
        </LinearLayout>

        <!-- Confiance -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvConf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="97.1%"
                android:textColor="#1D9E75"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="confiance"
                android:textColor="#B4B2A9"
                android:textSize="10sp"/>
        </LinearLayout>

        <!-- Flèche -->
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="10dp"
            android:src="@android:drawable/ic_media_next"
            android:tint="#D3D1C7"
            android:contentDescription="Voir détail"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>